{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lp-cme",
  "account_id": "c8e1fc4bfe2a0a591022a58cb8d7096e",
  "compatibility_date": "2026-10-01",
  // O build injeta as variáveis de ambiente nos arquivos estáticos.
  "build": {
    "command": "npm run build",
    "watch_dir": ["public", "scripts"]
  },
  // Apenas dist/ é publicado. O histórico fica fora de public/ e de dist/.
  // O domínio personalizado é gerenciado no painel Cloudflare, sem URL fixa aqui.
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
