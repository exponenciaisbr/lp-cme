{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lp-cme",
  "account_id": "c8e1fc4bfe2a0a591022a58cb8d7096e",
  "compatibility_date": "2026-10-01",
  // Site 100% estático: o Worker só serve os arquivos de ./public.
  // public/index-cme.html responde em /index-cme (sem extensão, sem barra final).
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
